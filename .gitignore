# Secrets — never commit.
# Anchored with a leading slash so these match only the repository-root `.env`.
# An unanchored `.env` would also match labs/fixtures/bad/html/.env, which is a
# *fixture* that the exposed-sensitive-file control depends on — excluding it silently
# breaks the bad fixture on a fresh clone.
/.env
/.env.*
!/.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Generated scan output (never contains committed evidence)
runs/

# Labs: the certificate is generated by labs/scripts/seed.sh, never committed
labs/fixtures/certs/*.crt
labs/fixtures/certs/*.key

# OS
.DS_Store

# Local tooling artifacts — not part of the project
.commandcode/
.impeccable/

# Reproducible upstream archives, downloaded by scripts/fetch_m3_tools.py
/workers/vendor/

# Local presentation exports and machine-specific packaging inventories
/artifacts/
/PACKAGE_MANIFEST.json
