# ScopeLens environment template.
#
# Copy to `.env` (or run `make init-env`, which substitutes real random values for
# every unfilled placeholder below). `.env` is gitignored. Never commit a filled-in
# copy, and never put a real credential in this file.

SCOPELENS_ENVIRONMENT=dev

# --- PostgreSQL (Build Plan §3) ---------------------------------------------------
# Consumed by deploy/docker-compose.dev.yml and by the application.
SCOPELENS_POSTGRES_USER=scopelens
SCOPELENS_POSTGRES_PASSWORD=CHANGE_ME
SCOPELENS_POSTGRES_DB=scopelens
SCOPELENS_POSTGRES_PORT=5433
SCOPELENS_DATABASE_URL=postgresql+psycopg://scopelens:CHANGE_ME@localhost:5433/scopelens

# --- Operator account (Build Plan §5.1) — one seeded account, no signup -----------
SCOPELENS_OPERATOR_USERNAME=operator
# The application hashes this with bcrypt at seed time; the plaintext is never stored
# in the database or logged. Kept `$`-free on purpose: Docker Compose treats `$` in
# `.env` values as variable interpolation, which silently corrupts a bcrypt hash.
SCOPELENS_OPERATOR_PASSWORD=CHANGE_ME
# Alternative: supply a pre-computed bcrypt hash from `make hash-password` instead.
# It takes precedence over the plaintext above, but bcrypt hashes contain `$`, so you
# must escape each one as `$$` for Compose. Prefer the plaintext form locally.
# SCOPELENS_OPERATOR_PASSWORD_HASH=

# --- Session cookie --------------------------------------------------------------
# Generate with `openssl rand -hex 32`.
SCOPELENS_SESSION_SECRET=CHANGE_ME
SCOPELENS_SESSION_MAX_AGE_SECONDS=43200

# --- Ports -----------------------------------------------------------------------
# Host port the API is published on (loopback only). 8000 is the conventional choice
# but is frequently already taken by an unrelated local service; change this if
# `make run` reports "address already in use".
SCOPELENS_API_PORT=8090

# --- M1: execution (Build Plan §9 M1) ---------------------------------------------
# Scanner execution is real from M1. Turning this off does not stop the API starting —
# scans are then refused at creation rather than queued for a dispatcher that will not
# run. Per-scan request/byte/time limits live in scopelens/config.py and are tunable per
# scope through `budgets_override`. Approved concurrency/rate overrides may rise to
# separate hard ceilings; other budget overrides can only lower the defaults.
SCOPELENS_SCANNER_EXECUTION_ENABLED=true

# --- M1: Redis ---------------------------------------------------------------------
# Redis carries Celery deliveries only, but it sits on the control network next to the
# proxy, so it is password-protected: an unauthenticated instance there is a
# credential-free foothold for anything that reaches the network.
SCOPELENS_REDIS_PASSWORD=CHANGE_ME

# --- M1: dispatch and service addresses --------------------------------------------
# Set by deploy/docker-compose.dev.yml so each service resolves its siblings. The values
# below are the compose network names; running the API directly on the host would need
# these changed to localhost ports.
# SCOPELENS_REDIS_URL=redis://:<password>@redis:6379/0
# SCOPELENS_PROXY_HOST=proxy
# SCOPELENS_PROXY_HTTP_PORT=8080
# Global target-request capacity across scans; each scan keeps its approved scope limit.
# SCOPELENS_PROXY_MAX_IN_FLIGHT=8
# Hard per-scan ceilings; without a scope override, concurrency/rate stay at 2/2.
# SCOPELENS_SCOPE_MAX_IN_FLIGHT=8
# SCOPELENS_SCOPE_MAX_REQUESTS_PER_SECOND=10
# Absolute per-scan reviewed browser-action cap; exploration retains its own default.
# SCOPELENS_BROWSER_MAX_ACTIVE_ACTIONS=500
# SCOPELENS_PROXY_CA_PATH=/var/lib/mitmproxy/mitmproxy-ca-cert.pem
# SCOPELENS_TLS_LANE_URL=http://tls-lane:8080
# SCOPELENS_WORKER_NETWORK=scopelens_worker_net
# SCOPELENS_TOOL_WORKER_IMAGE=scopelens/tool-worker:dev
# SCOPELENS_POLICY_SERVICE_URL=http://api:8000

# --- Model providers (Build Plan §5.18) -------------------------------------------
# Placeholders only. The model adapter is M4. No model name is hardcoded in code:
# a role with no model configured is unavailable, not defaulted.
# SCOPELENS_PLANNER_MODEL__BASE_URL=https://api.openai.com/v1
# SCOPELENS_PLANNER_MODEL__MODEL=
# SCOPELENS_PLANNER_MODEL__API_KEY=
# SCOPELENS_BROWSER_MODEL__BASE_URL=
# SCOPELENS_VERIFICATION_MODEL__BASE_URL=
# SCOPELENS_REPORT_WRITER_MODEL__BASE_URL=

# Optional M2 advisory snapshot. Leave unset to report C06 unassessed.
# In Compose, use a file under the mounted checks_registry directory.
# SCOPELENS_ADVISORY_BUNDLE_FILE=/app/checks_registry/advisories/reviewed.json
# TLS lab CA is configured only on the TLS lane in docker-compose.dev.yml.

# M3 is enabled by make run-m3; bare Settings remain usable by M2 tests.
# SCOPELENS_BROWSER_ENABLED=true
# SCOPELENS_SCANNER_TOOLS_ENABLED=true
# SCOPELENS_BROWSER_MAX_ACTIONS=24
# SCOPELENS_BROWSER_MAX_STATES=12
# Optional approved browser vision role; no provider/model is selected automatically.
# SCOPELENS_BROWSER_MODEL__BASE_URL=https://approved-provider.example/v1
# SCOPELENS_BROWSER_MODEL__MODEL=operator-selected-model
# SCOPELENS_BROWSER_MODEL__API_KEY=
# SCOPELENS_BROWSER_MODEL__VISION=true
# SCOPELENS_BROWSER_MODEL__JSON_MODE=true
# SCOPELENS_APPROVED_MODEL_BASE_URLS=["https://approved-provider.example/v1"]
# SCOPELENS_BROWSER_MODEL_MAX_CALLS=3

# M4 adaptive backend. `make run-m4` enables the reviewed scan lanes.
# SCOPELENS_ADAPTIVE_ENABLED=true
# SCOPELENS_ADAPTIVE_MAX_TASKS=6
# SCOPELENS_MODEL_MAX_CALLS=30
# SCOPELENS_MODEL_COST_CEILING=5
# Set current provider pricing for each configured role, including fallbacks.
# SCOPELENS_PLANNER_MODEL__JSON_MODE=true
# Optional; omit for a provider that does not accept reasoning_effort.
# SCOPELENS_PLANNER_MODEL__REASONING_EFFORT=low
# SCOPELENS_PLANNER_MODEL__CONTEXT_TOKENS=32000
# SCOPELENS_PLANNER_MODEL__INPUT_PRICE_PER_MILLION=
# SCOPELENS_PLANNER_MODEL__OUTPUT_PRICE_PER_MILLION=
# SCOPELENS_GENERATED_SCRIPTS_ENABLED=false
# SCOPELENS_SANDBOX_GATEWAY_URL=http://host.docker.internal:8097
# Generate locally with cryptography.fernet.Fernet.generate_key(); keep with backups.
# SCOPELENS_EVIDENCE_ENCRYPTION_KEY=
SCOPELENS_EVIDENCE_RETENTION_DAYS=30

# Authenticated assessments: a separate Fernet key encrypts operator credentials.
# Generated by bootstrap_env.py for new installs. For an existing .env, run:
# python3 scripts/initialize_identity_key.py
# The initializer preserves any nonempty key. Keep this key with credential-volume
# backups; replacing it makes existing encrypted credentials unreadable.
# SCOPELENS_IDENTITY_ENCRYPTION_KEY=
# Host-only default; Compose explicitly uses its persistent identity_credentials volume.
# SCOPELENS_IDENTITY_STORE_PATH=./runs/identity_secrets

# Optional callback collector. Disabled until an explicit origin and key are configured.
# Local dev lab origin: ["http://172.28.0.17:8091"]. Requires the callbacks Compose profile.
SCOPELENS_CALLBACK_COLLECTOR_ORIGINS=[]
# New installs generate a separate key; existing installs can initialize it without rotation:
# python3 scripts/initialize_callback_key.py
# SCOPELENS_CALLBACK_SIGNING_KEY=

# Collection worker allowance. Crawl gets 50%, ZAP gets 30% capped at 600 seconds;
# the remainder is for the other reviewed checks and artifact flushing.
# Both are capped by the immutable scope wall-clock budget. Cancellation stays active.
SCOPELENS_WORKER_MAX_RUNTIME_SECONDS=1800
SCOPELENS_SCANNER_WORKER_MEMORY_LIMIT_MB=2048
# Host prioritization metadata only; does not grant broker or worker authority.
# Set the owned domains explicitly after confirming customer scope.
SCOPELENS_DISCOVERY_OWNED_DOMAINS=[]
